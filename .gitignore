**/gelsight_r15_data/*

# ===== 只同步 nlegs 主线: tasks 只留 nlegs_task, assets 只留 nlegs;
# amp/amp_engineai/sysid 及其脚本不再入库 (本地文件保留) =====
source/legs_rl_lab/legs_rl_lab/tasks/*
!source/legs_rl_lab/legs_rl_lab/tasks/__init__.py
!source/legs_rl_lab/legs_rl_lab/tasks/nlegs_task/
source/legs_rl_lab/legs_rl_lab/assets/*
!source/legs_rl_lab/legs_rl_lab/assets/__init__.py
!source/legs_rl_lab/legs_rl_lab/assets/nlegs/
