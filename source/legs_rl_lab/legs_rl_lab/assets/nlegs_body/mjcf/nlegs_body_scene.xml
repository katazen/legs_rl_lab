<mujoco model="nlegs_body_scene">
  <include file="nlegs_body.xml"/>

  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2"
             width="512" height="512"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 4" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="0 0 .05" material="ground_mat"
          condim="3" friction="1 .005 .0001"/>
  </worldbody>
</mujoco>
